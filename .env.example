# At least one way in is required: BEARER_TOKEN, INDIKO_URL, or a token minted
# with `bun run engine token create "<label>" --role <role>`.

# Break-glass admin token. Generate one: openssl rand -hex 32
BEARER_TOKEN=

# Sign in with indiko. PUBLIC_URL is this engine's public origin: tokens must
# carry it as their audience, and register it as a resource in indiko with the
# roles admin, editor, reader, limited and sync.
INDIKO_URL=
PUBLIC_URL=

# Seals the indiko sign-ins behind personal tokens. Unset disables them.
# Generate one: openssl rand -hex 32. Changing it kills every personal token.
SECRET_KEY=

# Chrome extension ids allowed to sign in (comma separated).
EXTENSION_IDS=

# Optional.
DATABASE_PATH=data/cedarengine.db
PORT=3000
HOST=127.0.0.1  # keep it on loopback unless you mean it
TRUST_PROXY=     # 1 behind caddy, so the audit log records the client address
AUDIT_RETENTION_DAYS=180
